load("//bazel:portable_binary.bzl", "portable_binary")

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

constraint_setting(
    name = "libc",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "musl",
    constraint_setting = ":libc",
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_x86_64_musl",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        ":musl",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "foe",
    actual = "//crates/cli:foe",
    visibility = ["//visibility:public"],
)

portable_binary(
    name = "foe-portable",
    binary = "//crates/cli:foe",
    platform = ":linux_x86_64_musl",
    toolchain = "@rust_toolchains//:rust_linux_x86_64_musl__x86_64-unknown-linux-musl__stable",
    visibility = ["//visibility:public"],
)
