                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "properties": {
                      "claim": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "seq": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": ["claim", "seq"],
