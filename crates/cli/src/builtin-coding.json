{
  "version": 0,
  "name": "coding",
  "instructions": {
    "role": "Run the declared coding workflow against the task."
  },
  "tools": ["read", "grep", "edit", "bash"],
  "grants": {
    "read": [],
    "write": []
  },
  "budget": {
    "model_calls": 0,
    "max_episodes": 3,
    "max_concurrent": 1
  },
  "model": {},
  "workflow": {
    "nodes": {
      "implement-task": {
        "model": {
          "name": "implement-task",
          "instructions": {
            "environment": "",
            "role": "Implement the task in the current directory, which is the root of every relative path. Inspect the workspace, make the requested changes, and run relevant checks after the final change. Each tool result begins with its log sequence as `[seq N]`. Return at least one `learned` claim whose `seq` cites such a result. Also report changed artifacts, validation, and unresolved risks."
          },
          "tools": ["read", "grep", "edit", "bash"],
          "grants": {
            "read": [],
            "write": []
          },
          "budget": {
            "model_calls": 0
          },
          "done_when": {
            "returns": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "changed_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "maxItems": 64
                },
                "validation": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "minItems": 1,
                  "maxItems": 32
                },
                "unresolved_risks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "maxItems": 16
                },
                "learned": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "properties": {
                      "claim": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "seq": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": ["claim", "seq"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["summary", "changed_paths", "validation", "unresolved_risks", "learned"],
              "additionalProperties": false
            }
          }
        },
        "follows": ["task"]
      },
      "audit-and-repair-task": {
        "model": {
          "name": "audit-and-repair-task",
          "instructions": {
            "environment": "",
            "role": "Independently determine whether the shared workspace satisfies the original task. Treat the implementation episode's completion claim and its cited `learned` observations as unverified. Derive one distinct `acceptance_evidence` item for every supplied requirement, including boundaries and cross-field relations. Inspect or check the exact final artifacts for each item and cite that tool result; do not infer acceptance from implementation-produced checks alone. When a requirement measures the portion of a final value that matches supplied input, align the complete final value to that input and include every contiguous matching extension. Treat boundaries asserted by the implementation as unverified. Test every interpretation consistent with the task text and supplied inputs unless evidence establishes one interpretation uniquely. A `passed` command result must exit zero without timing out. Repair every defect you find. After the last workspace write or executable call, revisit the whole map; earlier evidence is rejected, while that last command's successful result may itself be evidence. Mark a requirement `unmet` and describe it in `unresolved_risks` only when it cannot be repaired. Report every path changed by either episode, including valid implementation changes that required no audit edit."
          },
          "tools": ["read", "grep", "edit", "bash"],
          "grants": {
            "read": [],
            "write": []
          },
          "budget": {
            "model_calls": 0
          },
          "done_when": {
            "returns": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "changed_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "maxItems": 64
                },
                "validation": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "minItems": 1,
                  "maxItems": 32
                },
                "unresolved_risks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "maxItems": 16
                },
                "learned": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "properties": {
                      "claim": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "seq": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": ["claim", "seq"],
                    "additionalProperties": false
                  }
                },
                "acceptance_evidence": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "properties": {
                      "requirement": { "type": "string", "minLength": 1, "maxLength": 500 },
                      "status": { "enum": ["passed", "unmet"] },
                      "seq": { "type": "integer", "minimum": 0 }
                    },
                    "required": ["requirement", "status", "seq"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["summary", "changed_paths", "validation", "unresolved_risks", "learned", "acceptance_evidence"],
              "additionalProperties": false
            }
          },
          "model": {}
        },
        "follows": ["task", "implement-task"],
        "terminal": true
      }
    },
    "recovery": {
      "enabled": false
    }
  },
  "task": ""
}
