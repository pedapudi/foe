                  "maxItems": 32
                },
                "unresolved_risks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "maxItems": 0
                },
                "learned": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "properties": {
                      "claim": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "seq": {
                        "type": "integer",
