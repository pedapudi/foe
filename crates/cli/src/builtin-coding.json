{
  "version": 0,
  "name": "coding",
  "instructions": {
    "role": "Run the declared coding workflow against the task."
  },
  "tools": ["read", "grep", "edit", "bash"],
  "grants": {
    "read": [],
    "write": []
  },
  "budget": {
    "model_calls": 0,
    "max_episodes": 4,
    "max_concurrent": 1
  },
  "model": {},
  "workflow": {
    "nodes": {
      "implement-task": {
        "model": {
          "name": "implement-task",
          "instructions": {
            "environment": "",
            "role": "Implement the task in the current directory, which is the root of every relative path. Inspect the workspace, make the requested changes, and run relevant checks after the final change. Each tool result begins with its log sequence as `[seq N]`. Return at least one `learned` claim whose `seq` cites such a result. Also report changed artifacts, validation, and unresolved risks."
          },
          "tools": ["read", "grep", "edit", "bash"],
          "grants": {
            "read": [],
            "write": []
          },
          "budget": {
            "model_calls": 0
          },
          "done_when": {
            "returns": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "changed_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "maxItems": 64
                },
                "validation": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "minItems": 1,
                  "maxItems": 32
                },
                "unresolved_risks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "maxItems": 16
                },
                "learned": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "properties": {
                      "claim": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "seq": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": ["claim", "seq"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["summary", "changed_paths", "validation", "unresolved_risks", "learned"],
              "additionalProperties": false
            }
          }
        },
        "follows": ["task"]
      },
      "assess-task": {
        "model": {
          "name": "assess-task",
          "instructions": {
            "environment": "",
            "role": "Independently assess whether the shared workspace satisfies every requirement in the original task. Treat the implementation episode's completion claim and cited observations as unverified. Inspect artifacts and run checks without editing task artifacts. Distinguish the exact contract from a nearby interpretation. Evaluate supplied artifacts and inputs through the task's stated interface. Do not require absent formats or input variants. Prioritize required observable behavior. Preserve baseline identities, allowed transformation sets, and stated structural constraints. When a requirement depends on dividing a final value into task-defined, inserted, removed, replaced, or input-matching regions, derive every decomposition consistent with the task text and the complete supplied and final values. Evaluate every dependent bound and relation within each complete decomposition. Accept only when every task-consistent decomposition passes or current evidence establishes one interpretation uniquely. For a program interface, test at least two materially different valid inputs and generate a second fixture when the workspace supplies only one. Choose `accept` only when current observations support every requirement and no unresolved risk remains. Otherwise choose `repair` and return precise findings that a fresh coding episode can reproduce. Return at least one cited `learned` observation."
          },
          "tools": ["read", "grep", "bash"],
          "grants": {
            "read": [],
            "write": []
          },
          "budget": {
            "model_calls": 0
          },
          "done_when": {
            "returns": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "maxItems": 32
                },
                "validation": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "minItems": 1,
                  "maxItems": 32
                },
                "unresolved_risks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "maxItems": 16
                },
                "learned": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "properties": {
                      "claim": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "seq": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": ["claim", "seq"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["summary", "findings", "validation", "unresolved_risks", "learned"],
              "additionalProperties": false
            }
          },
          "model": {}
        },
        "follows": ["task", "implement-task"],
        "branches": {
          "accept": [],
          "repair": ["repair-task"]
        }
      },
      "repair-task": {
        "model": {
          "name": "repair-task",
          "instructions": {
            "environment": "",
            "role": "Repair the independent assessment's findings in the shared workspace. Treat every finding and unresolved risk as an obligation. Reproduce each one before changing an artifact, then resolve it or show with evidence that it cannot affect an original task requirement. Prioritize required observable behavior. Make the smallest change that satisfies the original task while preserving unrelated artifacts, baseline identities, allowed transformations, and structural constraints. After changing a value with multiple task-consistent decompositions, evaluate every dependent constraint under each complete decomposition. After the final change, run the strongest available task-relevant checks. Complete only after no task-critical risk remains. Return an empty `unresolved_risks` array, every path changed by either coding episode, every observed validation result, and at least one cited `learned` observation."
          },
          "tools": ["read", "grep", "edit", "bash"],
          "grants": {
            "read": [],
            "write": []
          },
          "budget": {
            "model_calls": 0
          },
          "done_when": {
            "returns": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "changed_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "maxItems": 64
                },
                "validation": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "minItems": 1,
                  "maxItems": 32
                },
                "unresolved_risks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "maxItems": 0
                },
                "learned": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "properties": {
                      "claim": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "seq": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": ["claim", "seq"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["summary", "changed_paths", "validation", "unresolved_risks", "learned"],
              "additionalProperties": false
            }
          },
          "model": {}
        },
        "follows": ["task", "implement-task", "assess-task"],
        "terminal": true
      }
    },
    "recovery": {
      "enabled": false
    }
  },
  "task": ""
}
