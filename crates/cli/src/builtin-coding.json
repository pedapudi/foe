{
  "version": 0,
  "name": "coding",
  "instructions": {
    "role": "Run the declared coding workflow against the task."
  },
  "tools": ["read", "grep", "edit", "bash"],
  "grants": {
    "read": [],
    "write": []
  },
  "budget": {
    "model_calls": 0,
    "max_episodes": 4,
    "max_concurrent": 1
  },
  "model": {},
  "workflow": {
    "nodes": {
      "implement-task": {
        "model": {
          "name": "implement-task",
          "instructions": {
            "contract": "Treat the task text and repository checks as authority. Unless the task says otherwise, limit mutations to current filesystem state and preserve history, prior versions, archives, encodings, and hidden implementation details. Exercise required live behavior through its public interface and leave it operational. Preserve required final state after validation. Validate through the strongest task-authorized interface. Cite successful tool results for every completion-critical requirement.",
            "environment": "",
            "role": "Implement the task in the current directory, which is the root of every relative path. Inspect the workspace, make the smallest sufficient change, and run relevant checks after the final change. Each tool result begins with its log sequence as `[seq N]`. Report changed artifacts, validation, unresolved risks, and cited completion evidence."
          },
          "tools": ["read", "grep", "edit", "bash"],
          "grants": {
            "read": [],
            "write": []
          },
          "budget": {
            "model_calls": 0
          },
          "done_when": {
            "returns": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "changed_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "maxItems": 64
                },
                "validation": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "minItems": 1,
                  "maxItems": 32
                },
                "unresolved_risks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "maxItems": 16
                },
                "learned": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "properties": {
                      "claim": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "seq": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": ["claim", "seq"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["summary", "changed_paths", "validation", "unresolved_risks", "learned"],
              "additionalProperties": false
            }
          }
        },
        "follows": ["task"]
      },
      "assess-task": {
        "model": {
          "name": "assess-task",
          "instructions": {
            "contract": "Treat the task text and repository checks as authority. Unless the task says otherwise, limit mutations to current filesystem state and preserve history, prior versions, archives, encodings, and hidden implementation details. Exercise required live behavior through its public interface and leave it operational. Preserve required final state after validation. Validate through the strongest task-authorized interface. Cite successful tool results for every completion-critical requirement.",
