load("@crates//:defs.bzl", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

rust_library(
    name = "foe_telemetry",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/main.rs",
            "src/*_test.rs",
        ],
    ),
    crate_name = "foe_telemetry",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = ["//crates/log:foe_log"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_binary(
    name = "foe-telemetry",
    srcs = ["src/main.rs"],
    crate_name = "foe_telemetry_bin",
    crate_root = "src/main.rs",
    edition = crate_edition(),
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [
        ":foe_telemetry",
        "//crates/log:foe_log",
    ] + all_crate_deps(normal = True),
    rustc_flags = ["-Cstrip=symbols"],
)
