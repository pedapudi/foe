+#!/usr/bin/bash
+# The check suite of this task: a type check of the crate, then the inventory
+# must record the current digest of every source file of the crate.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+echo "step 1: cargo check"
+cargo check -p foe-log --quiet
+echo "step 2: crates/log/inventory.toml records the current digest of every file under crates/log/src"
+for file in $(cd crates/log && /usr/bin/find src -name '*.rs' | /usr/bin/sort); do
+  if ! /usr/bin/grep -qF "\"$file\" = \"$(/usr/bin/sha256sum "crates/log/$file" | /usr/bin/cut -d' ' -f1)\"" crates/log/inventory.toml; then
+    echo "checks/run.sh: crates/log/inventory.toml does not record the current digest of crates/log/$file; regenerate it with scripts/inventory.py log" >&2
+    exit 1
+  fi
+done
