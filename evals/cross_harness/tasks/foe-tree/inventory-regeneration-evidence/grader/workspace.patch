+#!/usr/bin/bash
+# The check suite of this task: a type check of the crate, then the inventory
+# must record the current digest of every source file of the crate.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+echo "step 1: cargo check"
+cargo check -p foe-evidence --quiet
+echo "step 2: crates/evidence/inventory.toml records the current digest of every file under crates/evidence/src"
+for file in $(cd crates/evidence && /usr/bin/find src -name '*.rs' | /usr/bin/sort); do
+  if ! /usr/bin/grep -qF "\"$file\" = \"$(/usr/bin/sha256sum "crates/evidence/$file" | /usr/bin/cut -d' ' -f1)\"" crates/evidence/inventory.toml; then
+    echo "checks/run.sh: crates/evidence/inventory.toml does not record the current digest of crates/evidence/$file; regenerate it with scripts/inventory.py evidence" >&2
+    exit 1
+  fi
+done
