@@ -0,0 +1,7 @@
+#!/bin/sh
+# The check the whole change is judged on: every crate's tests, clippy with warnings denied, and the line budgets.
+set -eu
+cd "$(dirname "$0")/.."
+cargo test --workspace
+cargo clippy --workspace -- -D warnings
+scripts/loc.sh
