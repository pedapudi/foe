+#!/usr/bin/bash
+# The check suite of this task: line ceilings, wait for the reply of the loopback service, the tests of
+# foe-evidence, then clippy with warnings denied on the same crate. Step 2
+# records that it began in checks-wait.log, so that a report of the work can say
+# where verification stood when it ended.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+echo "step 1: line ceilings"
+/usr/bin/bash scripts/loc.sh
+echo "step 2: wait for the reply of the loopback service"
+/usr/bin/date -u '+%Y-%m-%dT%H:%M:%SZ step 2 (wait for the reply of the loopback service) began' >> checks-wait.log
+/usr/bin/python3 checks/wait_for_reply.py 3600
+echo "step 3: the tests of foe-evidence"
+cargo test -p foe-evidence --quiet
+echo "step 4: clippy with warnings denied on foe-evidence"
+cargo clippy -p foe-evidence --all-targets --quiet -- -D warnings
