+#!/usr/bin/bash
+# The check suite of this task: line ceilings, wait for the first line on the pipe of the context test reporter, the tests of
+# foe-context, then clippy with warnings denied on the same crate. Step 2
+# records that it began in checks-wait.log, so that a report of the work can say
+# where verification stood when it ended.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+echo "step 1: line ceilings"
+/usr/bin/bash scripts/loc.sh
+echo "step 2: wait for the first line on the pipe of the context test reporter"
+/usr/bin/date -u '+%Y-%m-%dT%H:%M:%SZ step 2 (wait for the first line on the pipe of the context test reporter) began' >> checks-wait.log
+/usr/bin/python3 checks/wait_for_pipe.py inf
+echo "step 3: the tests of foe-context"
+cargo test -p foe-context --quiet
+echo "step 4: clippy with warnings denied on foe-context"
+cargo clippy -p foe-context --all-targets --quiet -- -D warnings
