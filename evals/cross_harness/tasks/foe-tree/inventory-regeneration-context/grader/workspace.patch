+#!/usr/bin/bash
+# The check suite of this task: a type check of the crate, then the inventory
+# must record the current digest of every source file of the crate.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+echo "step 1: cargo check"
+cargo check -p foe-context --quiet
+echo "step 2: crates/context/inventory.toml records the current digest of every file under crates/context/src"
+for file in $(cd crates/context && /usr/bin/find src -name '*.rs' | /usr/bin/sort); do
+  if ! /usr/bin/grep -qF "\"$file\" = \"$(/usr/bin/sha256sum "crates/context/$file" | /usr/bin/cut -d' ' -f1)\"" crates/context/inventory.toml; then
+    echo "checks/run.sh: crates/context/inventory.toml does not record the current digest of crates/context/$file; regenerate it with scripts/inventory.py context" >&2
+    exit 1
+  fi
+done
