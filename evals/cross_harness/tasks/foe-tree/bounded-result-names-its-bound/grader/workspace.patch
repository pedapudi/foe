diff --git a/checks/run.sh b/checks/run.sh
new file mode 100755
index 0000000..70efb5a
--- /dev/null
+++ b/checks/run.sh
@@ -0,0 +1,10 @@
+#!/bin/sh
+# The check this task is judged on: the crate's tests, clippy with
+# warnings denied on the same crate, and the line budgets.
+# The three compose_tools tests whose names hold `inner_call` dispatch an inner tool call over the
+# interpreter's Unix socket pair, which a kernel sandbox may deny, so this suite leaves them out.
+set -eu
+cd "$(dirname "$0")/.."
+cargo test -p foe-code -- --skip inner_call
+cargo clippy -p foe-code --all-targets -- -D warnings
+scripts/loc.sh
