load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(
    [
        "foe_source_identity.py",
        "harness_bench.BUILD.bazel",
        "knowledge_qa_claim_scoring.patch",
    ],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "foe-development",
    srcs = ["run_foe.py"],
    args = [
        "--foe",
        "$(rootpath //:foe)",
        "--source-root",
        "$(rootpath //:Cargo.toml)",
        "--trace-evaluator",
        "$(rootpath //evals:score-trace)",
        "--task-dir",
        "$(rootpath @harness_bench//:task_015_yaml)",
        "--task-dir",
        "$(rootpath @harness_bench//:task_043_yaml)",
        "--task-dir",
        "$(rootpath @harness_bench//:task_078_yaml)",
        "--task-dir",
        "$(rootpath @harness_bench//:task_083_yaml)",
    ],
    data = [
        "//:foe",
        "//:Cargo.toml",
        "//evals:score-trace",
        "foe_source_identity.py",
        "@harness_bench//:development_tasks",
        "@harness_bench//:task_015_yaml",
        "@harness_bench//:task_043_yaml",
        "@harness_bench//:task_078_yaml",
        "@harness_bench//:task_083_yaml",
    ],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "foe-confirmation",
    srcs = ["run_foe.py"],
    args = [
        "--foe",
        "$(rootpath //:foe)",
        "--source-root",
        "$(rootpath //:Cargo.toml)",
        "--trace-evaluator",
        "$(rootpath //evals:score-trace)",
        "--task-dir",
        "$(rootpath @harness_bench//:task_085_yaml)",
        "--task-dir",
        "$(rootpath @harness_bench//:task_096_yaml)",
    ],
    data = [
        "//:foe",
        "//:Cargo.toml",
        "//evals:score-trace",
        "foe_source_identity.py",
        "@harness_bench//:confirmation_tasks",
        "@harness_bench//:task_085_yaml",
        "@harness_bench//:task_096_yaml",
    ],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "collect-evidence",
    srcs = ["collect_evidence.py"],
    data = ["foe_source_identity.py"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "self-improve",
    srcs = ["run_self_improvement.py"],
    args = [
        "--foe",
        "$(rootpath //:foe)",
    ],
    data = [
        "//:foe",
        "foe_source_identity.py",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "foe_development_test",
    srcs = ["run_unit_tests.sh"],
    data = [
        "run_foe.py",
        "run_foe_test.py",
        "collect_evidence.py",
        "collect_evidence_test.py",
        "foe_source_identity.py",
        "foe_source_identity_test.py",
        "knowledge_qa_claim_scoring.patch",
        "run_self_improvement.py",
        "run_self_improvement_test.py",
    ],
    size = "small",
)

genrule(
    name = "patched_knowledge_qa_grader",
    srcs = ["@harness_bench//:task_096_oracle"],
    outs = ["knowledge_qa_task/oracle_grade.py"],
    cmd = "cp $< $@",
)

genrule(
    name = "patched_knowledge_qa_ground_truth",
    srcs = ["@harness_bench//:task_096_ground_truth"],
    outs = ["knowledge_qa_task/ground_truth.json"],
    cmd = "cp $< $@",
)

sh_test(
    name = "knowledge_qa_grader_test",
    srcs = ["knowledge_qa_grader_test.py"],
    data = [
        "knowledge_qa_oracle.json",
        ":patched_knowledge_qa_grader",
        ":patched_knowledge_qa_ground_truth",
    ],
    size = "small",
)
