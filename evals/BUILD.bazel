load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(
    ["foe_source_identity.py"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "score-trace",
    srcs = ["trace_quality.py"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "runtime-evals",
    srcs = ["run_runtime_evals.py"],
    args = ["--foe", "$(rootpath //:foe)"],
    data = [
        "scripted_transport.py",
        "trace_quality.py",
        "//:foe",
    ],
)

sh_binary(
    name = "micro",
    srcs = ["run_micro_evals.py"],
    args = [
        "--foe",
        "$(rootpath //:foe)",
        "--source-root",
        "$(rootpath //:Cargo.toml)",
    ],
    data = [
        "micro_tasks.py",
        "trace_quality.py",
        "//:Cargo.toml",
        "//:foe",
        "foe_source_identity.py",
    ],
)

sh_test(
    name = "trace_quality_test",
    srcs = ["run_unit_tests.sh"],
    data = [
        "foe_source_identity.py",
        "foe_source_identity_test.py",
        "trace_quality.py",
        "trace_quality_test.py",
    ],
    size = "small",
)

sh_test(
    name = "runtime_evals_test",
    srcs = ["run_runtime_evals.py"],
    args = ["--foe", "$(rootpath //:foe)"],
    data = [
        "scripted_transport.py",
        "trace_quality.py",
        "//:foe",
    ],
    size = "small",
)

sh_test(
    name = "micro_tasks_test",
    srcs = ["run_micro_unit_tests.sh"],
    data = [
        "micro_tasks.py",
        "micro_tasks_test.py",
        "run_micro_evals.py",
        "trace_quality.py",
    ],
    size = "small",
)

test_suite(
    name = "conformance_tests",
    tests = [
        ":runtime_evals_test",
        ":micro_tasks_test",
        ":trace_quality_test",
    ],
)
