module(
    name = "foe",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "harness_bench",
    build_file = "//evals/harness_bench:harness_bench.BUILD.bazel",
    patch_args = ["-p1"],
    patches = ["//evals/harness_bench:knowledge_qa_claim_scoring.patch"],
    sha256 = "4c461ba3af647bad9eaa5c59b875236893ef16880b812eb524f2efdc1b7c4ce7",
    strip_prefix = "harness-bench-1025086a446653702b80cfb48babbeec35db6b2c",
    urls = ["https://github.com/Qihoo360/harness-bench/archive/1025086a446653702b80cfb48babbeec35db6b2c.tar.gz"],
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.95.0"],
)
rust.repository_set(
    name = "rust_linux_x86_64_musl",
    edition = "2021",
    exec_triple = "x86_64-unknown-linux-gnu",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "//:musl",
    ],
    target_triple = "x86_64-unknown-linux-musl",
    versions = ["1.95.0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")
