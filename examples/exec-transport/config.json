{
  "version": 1,
  "name": "exec-transport",
  "instructions": {
    "role": "You are a coding agent. Read the file named in the task and summarize it in one sentence."
  },
  "tools": ["read", "grep"],
  "grants": {
    "read": ["/home/user/project"]
  },
  "budget": { "model_calls": 6, "seconds": 120 },
  "model": {
    "provider": "exec",
    "exec": "/home/user/project/tools/litellm-transport",
    "model": "openai/gpt-5",
    "api_key_file": "/home/user/project/.secrets/openai.key"
  },
  "task": "Summarize /home/user/project/README.md in one sentence."
}
