load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

SELF_EXTENSION_DATA = [
    "check",
    "config.json",
    "workflow-config.json",
    "//:foe",
    "//crates/code:self_extension_sources",
    "//docs:self_extension_sources",
    "//evals:score-trace",
    "//examples/support:host_runner",
    "//examples/support:materialize.py",
    "//examples/support:responses.py",
]

sh_binary(
    name = "self-extension",
    srcs = ["run.sh"],
    args = ["$(rootpath //:foe)"],
    data = SELF_EXTENSION_DATA,
)

sh_binary(
    name = "self-extension-model",
    srcs = ["run-model.sh"],
    args = ["$(rootpath //:foe)"],
    data = SELF_EXTENSION_DATA,
)

sh_binary(
    name = "self-improvement-workflow",
    srcs = ["run.sh"],
    args = [
        "$(rootpath //:foe)",
        "--workflow",
    ],
    data = SELF_EXTENSION_DATA,
)

sh_binary(
    name = "self-improvement-workflow-model",
    srcs = ["run-model.sh"],
    args = [
        "$(rootpath //:foe)",
        "--workflow",
    ],
    data = SELF_EXTENSION_DATA,
)

sh_test(
    name = "self_extension_test",
    srcs = ["run.sh"],
    args = ["$(rootpath //:foe)"],
    data = SELF_EXTENSION_DATA,
    size = "small",
)

sh_test(
    name = "self_improvement_workflow_test",
    srcs = ["run.sh"],
    args = [
        "$(rootpath //:foe)",
        "--workflow",
    ],
    data = SELF_EXTENSION_DATA,
    size = "small",
)

sh_test(
    name = "check_test",
    srcs = ["check_test.sh"],
    args = ["$(rootpath :check)"],
    data = ["check"],
    size = "small",
)
