load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

SELF_EXTENSION_DATA = [
    "check",
    "config.json",
    "//:foe",
    "//crates/code:self_extension_sources",
    "//docs:self_extension_sources",
    "//examples/support:materialize.py",
    "//examples/support:scripted-transport.py",
]

SELF_EXTENSION_MODEL_DATA = SELF_EXTENSION_DATA + [
    "//evals:score-trace",
]

sh_binary(
    name = "self-extension",
    srcs = ["run.sh"],
    args = ["$(rootpath //:foe)"],
    data = SELF_EXTENSION_DATA,
)

sh_binary(
    name = "self-extension-model",
    srcs = ["run-model.sh"],
    args = ["$(rootpath //:foe)"],
    data = SELF_EXTENSION_MODEL_DATA,
)

sh_test(
    name = "self_extension_test",
    srcs = ["run.sh"],
    args = ["$(rootpath //:foe)"],
    data = SELF_EXTENSION_DATA,
    size = "small",
)

sh_test(
    name = "check_test",
    srcs = ["check_test.sh"],
    args = ["$(rootpath :check)"],
    data = ["check"],
    size = "small",
)

sh_test(
    name = "self_extension_model_runner_test",
    srcs = ["run-model.sh"],
    args = [
        "$(rootpath //:foe)",
        "--model",
        "exec/self-extension-demo",
        "--confirm-spend",
    ],
    data = SELF_EXTENSION_MODEL_DATA,
    size = "small",
)
